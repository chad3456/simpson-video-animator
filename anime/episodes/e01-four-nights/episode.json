     "text": "A whole moment of bliss. Is it too little for a whole life?"
    },
    {
     "who": "itsuki",
     "thought": true,
     "emo": "sad",
     "look": "up",
     "shot": "close:itsuki",
     "text": "I used to know the answer."
    },
    {
     "dur": 2.0,
     "shot": "close:itsuki",
     "react": {
