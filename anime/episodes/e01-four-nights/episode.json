  {
   "type": "scene",
   "id": "bridge-1",
   "lines": [
    {
     "dur": 3.0,
     "shot": "wide"
    },
    {
     "who": "mio",
     "thought": true,
     "look": "up",
     "shot": "close:mio",
     "text": "He said yes. I know, because I'd stopped outside the window to see if he would."
    },
    {
     "who": "mio",
     "thought": true,
     "emo": "smile",
     "look": "down",
     "shot": "close:mio",
     "text": "Gramps, I think I met someone who reads the way you did. Like the book might answer back."
    },
    {
     "who": "mio",
     "thought": true,
     "emo": "warm",
     "look": "up",
     "shot": "mcu:mio",
     "text": "The Dreamer got four nights. I wonder how many we get."
    },
    {
     "dur": 4.0,
     "shot": "wide"
    }
   ],
   "chars": {
    "mio": {
     "slot": "railL",
     "emo": "soft",
     "pose2": "rail",
     "idleLook": "up"
    }
   },
   "set": "bridge",
   "season": "summer",
   "music": "theme",
   "musicVol": 0.8,
   "amb": [
    "crickets"
   ]
  },
  {
   "type": "scene",
   "id": "street-1",
   "lines": [
    {
     "dur": 3.0,
     "shot": "wide",
     "sfx": "steps"
    },
    {
     "who": "itsuki",
     "thought": true,
     "look": "down",
     "shot": "mcu:itsuki",
     "text": "People like us. Somewhere to be."
    },
    {
     "who": "itsuki",
     "thought": true,
     "emo": "serious",
     "look": "front",
     "shot": "mcu:itsuki",
     "text": "She's seventeen. She has school, and a mother, and a whole life that starts again tomorrow morning. She doesn't need a man who talks to buildings."
    },
    {
     "who": "itsuki",
     "thought": true,
     "look": "down",
     "shot": "wide",
     "text": "It's only a book. Talking about a book with someone is allowed."
    },
    {
     "who": "itsuki",
     "thought": true,
     "emo": "soft",
     "look": "up",
     "shot": "mcu:itsuki",
     "text": "Same time next Thursday. Nobody has said \"next Thursday\" to me in years."
    },
    {
     "dur": 3.5,
     "shot": "wide",
     "sfx": "crossing"
    }
   ],
   "chars": {
    "itsuki": {
     "slot": "walkR",
     "pose": "walk",
     "emo": "neutral",
     "idleLook": "down"
    }
   },
   "set": "street",
   "season": "summer",
   "music": "night",
   "musicVol": 0.8,
   "amb": [
    "crickets",
    "city"
   ]
  },
  {
