    {
     "who": "narrator",
     "text": "काम्पिल्य में यज्ञदत्त नाम के एक विद्वान पुरोहित रहते थे, जिनका राजा भी आदर करते थे। उनका एक ही पुत्र था, गुणनिधि, चंद्रमा जैसा सुंदर।",
     "text_hi": "काम्पिल्य में यज्ञदत्त नाम के एक विद्वान पुरोहित रहते थे, जिनका राजा भी आदर करते थे। उनका एक ही पुत्र था, गुणनिधि, चंद्रमा जैसा सुंदर।",
     "cam": "wide"
    },
    {
     "who": "narrator",
     "text": "पर गुणनिधि का एक रहस्य था। वह जुआ खेलता था। और हारता था। हर दिन।",
     "text_hi": "पर गुणनिधि का एक रहस्य था। वह जुआ खेलता था। और हारता था। हर दिन।",
     "cam": "mid:gunanidhi"
    },
    {
     "who": "yajnadatta",
     "text": "हमारा पुत्र कहाँ है? मैं उसे कभी घर पर नहीं देखता।",
     "text_hi": "हमारा पुत्र कहाँ है? मैं उसे कभी घर पर नहीं देखता।",
     "cam": "mid:yajnadatta"
    },
    {
     "who": "mother",
     "text": "अभी-अभी पढ़ने गया है, दो-तीन मित्रों के साथ।",
     "text_hi": "अभी-अभी पढ़ने गया है, दो-तीन मित्रों के साथ।",
     "cam": "mid:mother"
    },
    {
     "who": "narrator",
     "text": "वह अपने इकलौते बेटे से प्रेम करती थी, इसलिए बार-बार झूठ बोलती रही। और गुणनिधि बर्तन, कपड़े और गहने उठाकर जुआघरों में ले जाता रहा।",
     "text_hi": "वह अपने इकलौते बेटे से प्रेम करती थी, इसलिए बार-बार झूठ बोलती रही। और गुणनिधि बर्तन, कपड़े और गहने उठाकर जुआघरों में ले जाता रहा।",
     "camMove": true,
     "cam": "wide",
     "capPos": "bottom"
    }
   ],
