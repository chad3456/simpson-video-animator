    {
     "who": "narrator",
     "text": "एक और युग में, वही आत्मा काशी आई, और इतने समय तक तप किया कि शरीर केवल हड्डियों का ढाँचा रह गया।",
     "text_hi": "एक और युग में, वही आत्मा काशी आई, और इतने समय तक तप किया कि शरीर केवल हड्डियों का ढाँचा रह गया।",
     "cam": "wide"
    },
    {
     "text": "",
     "dur": 2.0,
     "cam": "wide",
     "sfx": "om",
     "swell": true,
     "flash": true
    },
    {
     "who": "shiva",
     "text": "आँखें खोलो, मेरे भक्त। मैं प्रसन्न हूँ। वर माँगो।",
     "text_hi": "आँखें खोलो, मेरे भक्त। मैं प्रसन्न हूँ। वर माँगो।",
     "cam": "mid:shiva"
    },
    {
     "who": "kubera",
     "text": "शिव के पास बैठी ये देवी कौन हैं? इन्होंने ऐसा कौन-सा तप किया कि इनके इतने निकट बैठी हैं?",
     "text_hi": "शिव के पास बैठी ये देवी कौन हैं? इन्होंने ऐसा कौन-सा तप किया कि इनके इतने निकट बैठी हैं?",
     "cam": "close:kubera"
    },
    {
     "text": "",
     "dur": 1.2,
     "cam": "ecu:kubera",
     "sfx": "crack",
     "flash": true,
     "shake": 6,
     "bang": "KRAK!|चट!",
     "bangPos": "980,170"
    },
    {
     "who": "narrator",
     "text": "वह देखता रहा, बार-बार देखता रहा। और उसकी बाईं आँख फूट गई।",
     "text_hi": "वह देखता रहा, बार-बार देखता रहा। और उसकी बाईं आँख फूट गई।",
     "cam": "mid:kubera",
     "capPos": "bottom"
    },
    {
     "who": "uma",
     "text": "यह तपस्वी मुझे बार-बार क्यों घूर रहा है?",
     "text_hi": "यह तपस्वी मुझे बार-बार क्यों घूर रहा है?",
     "cam": "mid:uma"
    },
    {
     "who": "shiva",
     "text": "उमा, यह तुम्हारा पुत्र है। यह तुम्हें बालक की तरह विस्मय से देख रहा है, बुरी दृष्टि से नहीं।",
     "text_hi": "उमा, यह तुम्हारा पुत्र है। यह तुम्हें बालक की तरह विस्मय से देख रहा है, बुरी दृष्टि से नहीं।",
     "cam": "two:shiva,uma"
    },
    {
     "text": "",
     "dur": 1.0,
     "cam": "wide",
     "sfx": "sparkle",
     "flash": true
    },
    {
     "who": "shiva",
     "text": "तुम कुबेर बनो, समस्त धन के स्वामी। अलका पर राज करो। तुम्हारी आँख पीली है, इसलिए लोग तुम्हें एकपिंग कहेंगे। और मैं तुम्हारा मित्र रहूँगा।",
     "text_hi": "तुम कुबेर बनो, समस्त धन के स्वामी। अलका पर राज करो। तुम्हारी आँख पीली है, इसलिए लोग तुम्हें एकपिंग कहेंगे। और मैं तुम्हारा मित्र रहूँगा।",
     "cam": "mid:shiva"
    },
    {
     "who": "shiva",
     "text": "मैं कैलास पर अपना निवास बनाऊँगा, तुम्हारे नगर के ठीक पास।",
     "text_hi": "मैं कैलास पर अपना निवास बनाऊँगा, तुम्हारे नगर के ठीक पास।",
     "cam": "close:shiva"
    }
