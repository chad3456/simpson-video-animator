   "lines": [
    {
     "text": "",
     "dur": 0.6,
     "cam": "wide",
     "sfx": "heartbeat"
    },
    {
     "who": "narrator",
     "text": "When all were asleep, he crept inside. The lamp was dying. He could barely see the food.",
     "text_hi": "जब सब सो गए, वह चुपके से भीतर घुसा। दीपक बुझने वाला था। उसे भोजन ठीक से दिख भी नहीं रहा था।",
     "cam": "wide"
    },
    {
     "text": "",
     "dur": 1.0,
     "cam": "mid:gunanidhi",
     "sfx": "crack",
     "bang": "RRRIP!|चर्र!",
     "bangPos": "300,180"
    },
    {
     "who": "narrator",
     "text": "So he tore a strip from his own cloth and twisted it into a new wick.",
     "text_hi": "तो उसने अपने वस्त्र से एक पट्टी फाड़ी और उसे बटकर नई बत्ती बना दी।",
     "cam": "mid:gunanidhi",
     "capPos": "bottom"
    },
    {
     "text": "",
     "dur": 1.6,
     "camMove": true,
     "cam": "at:560,520,1.5",
     "sfx": "fire",
     "flash": "#ffd27a"
    },
    {
     "who": "narrator",
     "text": "The flame leapt up, and its light fell full upon the lingam.",
     "text_hi": "लौ ऊँची उठी, और उसका प्रकाश सीधे लिंग पर पड़ा।",
     "cam": "at:560,520,1.5"
    },
    {
     "who": "narrator",
     "text": "He grabbed the food and ran.",
     "text_hi": "उसने भोजन उठाया और भाग निकला।",
     "camMove": true,
     "cam": "wide",
     "capPos": "bottom"
    }
   ],
