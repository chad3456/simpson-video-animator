   "lines": [
    {
     "text": "",
     "dur": 0.6,
     "cam": "wide",
     "sfx": "bells"
    },
    {
     "who": "narrator",
     "text": "After a time in Shiva's world, he was born again, as Dama, prince of Kalinga. Even as a boy, he loved Shiva.",
     "text_hi": "शिवलोक में कुछ समय बिताकर, उसने फिर जन्म लिया, कलिंग के राजकुमार दम के रूप में। बचपन से ही उसे शिव से प्रेम था।",
     "cam": "wide"
    },
    {
     "who": "dama",
     "text": "Let a lamp burn in every Shiva temple in my kingdom. Every single one. Every night.",
     "text_hi": "मेरे राज्य के हर शिव मंदिर में दीपक जले। हर एक में। हर रात।",
     "cam": "mid:dama"
    },
    {
     "who": "narrator",
     "text": "And so they did. King Dama lit a thousand lamps, for the one he had lit by accident.",
     "text_hi": "और ऐसा ही हुआ। राजा दम ने हज़ार दीपक जलवाए, उस एक के बदले जो उसने अनजाने में जलाया था।",
     "camMove": true,
     "cam": "wide",
     "capPos": "bottom"
    }
   ],
   "music": "joy",
   "amb": [
    "temple"
   ],
   "trans": "wipe",
   "caption": "Many years later, in Kalinga",
   "caption_hi": "कई वर्ष बाद, कलिंग में"
  },
