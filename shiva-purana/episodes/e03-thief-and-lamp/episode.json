    },
    {
     "who": "narrator",
     "text": "Gunanidhi heard, and fled the city. He had no learning, no money, no friends.",
     "text_hi": "गुणनिधि ने यह सुना, और नगर छोड़कर भाग गया। न विद्या थी, न धन, न मित्र।",
     "cam": "wide"
    },
    {
     "who": "gunanidhi",
     "text": "Where will I go? Who will feed me now? Every morning, my mother gave me sweet food.",
     "text_hi": "अब कहाँ जाऊँ? अब मुझे कौन खिलाएगा? हर सुबह माँ मुझे मीठा भोजन खिलाती थी।",
     "cam": "close:gunanidhi"
    },
    {
     "who": "narrator",
     "text": "He sat under a tree, hungry, as the sun went down. It was the night of Shivaratri.",
     "text_hi": "वह भूखा एक पेड़ के नीचे बैठ गया, और सूरज डूब गया। वह शिवरात्रि की रात थी।",
     "camMove": true,
     "cam": "wide",
     "capPos": "bottom"
    }
