   "lines": [
    {
     "text": "",
     "dur": 0.6,
     "cam": "wide",
     "sfx": "roar"
    },
    {
     "who": "yamadoot",
     "text": "This one is ours! He comes to Yama's city, bound in our nooses!",
     "text_hi": "यह हमारा है! यह हमारे पाशों में बँधकर यमपुरी चलेगा!",
     "cam": "mid:yamadoot"
    },
    {
     "text": "",
     "dur": 1.0,
     "cam": "wide",
     "sfx": "sparkle"
    },
    {
     "who": "shivadoot",
     "text": "Release him. He is devoted to dharma. All his sins have been burned away.",
     "text_hi": "इसे छोड़ दो। यह धर्मनिष्ठ है। इसके सारे पाप जल चुके हैं।",
     "cam": "mid:shivadoot"
    },
    {
     "who": "yamadoot",
     "text": "Devoted? He gambled, lied, stole, and even stole the food offered to Shiva!",
     "text_hi": "धर्मनिष्ठ? इसने जुआ खेला, झूठ बोला, चोरी की, और शिव का भोग तक चुराया!",
     "cam": "two:yamadoot,gunanidhi"
    },
    {
     "who": "shivadoot",
     "text": "Shiva's dharma is subtle. You see only the gross. Listen.",
     "text_hi": "शिव का धर्म सूक्ष्म है। तुम केवल स्थूल देखते हो। सुनो।",
     "cam": "mid:shivadoot"
    },
    {
     "who": "shivadoot",
     "text": "When the lingam was in shadow, he tore his own cloth to make a wick. He fasted all night. He heard Shiva's names, and watched his worship.",
     "text_hi": "जब लिंग अँधेरे में था, उसने अपना वस्त्र फाड़कर बत्ती बनाई। उसने रात भर उपवास किया। उसने शिव के नाम सुने, और उनकी पूजा देखी।",
     "cam": "close:shivadoot"
    },
    {
     "who": "shivadoot",
     "text": "It was the night of Shivaratri. He comes with us.",
     "text_hi": "वह शिवरात्रि की रात थी। यह हमारे साथ चलेगा।",
     "cam": "two:shivadoot,gunanidhi"
    },
    {
     "who": "narrator",
     "text": "Yama's messengers bowed and left. And Yama told them: never bring anyone who wears Shiva's ash or rudraksha.",
     "text_hi": "यमदूत सिर झुकाकर लौट गए। और यमराज ने उनसे कहा, जो शिव की भस्म या रुद्राक्ष धारण करे, उसे कभी मत लाना।",
     "camMove": true,
     "cam": "wide",
     "sfx": "magic",
     "capPos": "bottom"
    }
   ],
   "music": "tension",
   "amb": [
    "fire"
   ],
   "trans": "ink"
  },
