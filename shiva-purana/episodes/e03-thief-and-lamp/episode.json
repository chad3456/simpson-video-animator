   "lines": [
    {
     "text": "",
     "dur": 0.6,
     "cam": "wide",
     "sfx": "om"
    },
    {
     "who": "narrator",
     "text": "In another age, the same soul came to Kashi, and meditated for so long that he became skin and bone.",
     "text_hi": "एक और युग में, वही आत्मा काशी आई, और इतने समय तक तप किया कि शरीर केवल हड्डियों का ढाँचा रह गया।",
     "cam": "wide"
    },
    {
     "text": "",
     "dur": 2.0,
     "cam": "wide",
     "sfx": "om",
     "swell": true,
     "flash": true
    },
    {
     "who": "shiva",
     "text": "Open your eyes, my devotee. I am pleased. Ask for a boon.",
     "text_hi": "आँखें खोलो, मेरे भक्त। मैं प्रसन्न हूँ। वर माँगो।",
     "cam": "mid:shiva"
    },
    {
     "who": "kubera",
     "text": "Who is this lady beside Shiva? What austerities did she do, to sit so close to him?",
     "text_hi": "शिव के पास बैठी ये देवी कौन हैं? इन्होंने ऐसा कौन-सा तप किया कि इनके इतने निकट बैठी हैं?",
     "cam": "close:kubera"
    },
    {
     "text": "",
     "dur": 1.2,
     "cam": "ecu:kubera",
     "sfx": "crack",
     "flash": true,
     "shake": 6,
     "bang": "KRAK!|चट!",
     "bangPos": "980,170"
    },
    {
     "who": "narrator",
     "text": "He stared, and stared again. And his left eye burst.",
     "text_hi": "वह देखता रहा, बार-बार देखता रहा। और उसकी बाईं आँख फूट गई।",
