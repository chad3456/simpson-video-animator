   "lines": [
    {
     "text": "",
     "dur": 0.8,
     "cam": "wide",
     "sfx": "bells"
    },
    {
     "who": "narrator",
     "text": "A devotee of Shiva passed by with his family, carrying offerings of food to the temple. They had fasted all day.",
     "text_hi": "शिव का एक भक्त अपने परिवार के साथ वहाँ से गुज़रा, मंदिर के लिए भोग लिए हुए। उन्होंने दिन भर उपवास किया था।",
     "cam": "wide"
    },
    {
     "who": "narrator",
     "text": "All night they sang Shiva's names and worshipped the lingam.",
     "text_hi": "रात भर उन्होंने शिव के नाम गाए और लिंग की पूजा की।",
     "cam": "mid:devotee"
    },
    {
     "who": "gunanidhi",
     "text": "That food smells wonderful. When they fall asleep, it is mine.",
     "text_hi": "उस भोजन की सुगंध कितनी अच्छी है। जब ये सो जाएँगे, तब यह मेरा होगा।",
     "cam": "mid:gunanidhi"
    },
    {
     "who": "narrator",
     "text": "So he sat at the temple door, without food, listening to Shiva's names all night long.",
     "text_hi": "तो वह मंदिर के द्वार पर भूखा बैठा रहा, और रात भर शिव के नाम सुनता रहा।",
     "camMove": true,
     "cam": "close:gunanidhi"
    }
   ],
   "music": "shiva",
   "amb": [
    "temple"
   ],
   "trans": "ink"
  },
