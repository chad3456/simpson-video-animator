   "lines": [
    {
     "text": "",
     "dur": 0.4,
     "cam": "wide"
    },
    {
     "who": "suta",
     "text": "A pillar of fire with no end. A proud sage with a monkey's face. A thief with a lamp. A goddess who gave her life, and came back.",
     "text_hi": "अनंत अग्नि-स्तंभ। बंदर के मुँह वाला अभिमानी ऋषि। दीपक वाला चोर। एक देवी जिसने प्राण दिए, और लौट आई।",
     "cam": "mid:suta"
    },
    {
     "who": "suta",
     "text": "Whoever hears these stories with love, Shiva is pleased with them. That is the Shiva Purana.",
     "text_hi": "जो इन कथाओं को प्रेम से सुनता है, शिव उससे प्रसन्न होते हैं। यही है शिव पुराण।",
     "cam": "close:suta"
    },
    {
     "who": "rishi",
     "text": "Om Namah Shivaya.",
     "text_hi": "ॐ नमः शिवाय।",
     "cam": "mid:rishi"
    }
