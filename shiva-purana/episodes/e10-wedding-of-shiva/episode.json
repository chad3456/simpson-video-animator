   "lines": [
    {
     "text": "",
     "dur": 0.3,
     "cam": "wide",
     "sfx": "damaru"
    },
    {
     "who": "narrator",
     "text": "And then came Shiva's own army. Ghosts and goblins. Some with no heads, some with many heads. Some riding backwards, some blowing horns, beating drums, howling.",
     "text_hi": "और फिर आई शिव की अपनी सेना। भूत-प्रेत। किसी का सिर नहीं, किसी के कई सिर। कोई उल्टा सवार, कोई सींग बजाता, ढोल पीटता, चिल्लाता।",
     "camMove": true,
     "cam": "wide",
     "sfx": "roar"
    },
    {
     "who": "narad",
     "text": "Look, Mena. There is Shiva.",
     "text_hi": "देखिए, मेना। वह रहे शिव।",
     "cam": "two:mena,shiva"
    },
    {
     "who": "narrator",
     "text": "Ash-smeared, wearing a tiger skin, snakes coiled around his neck, a skull in his hand, riding a bull.",
     "text_hi": "भस्म रमाए, बाघम्बर पहने, गले में लिपटे साँप, हाथ में खोपड़ी, बैल पर सवार।",
     "cam": "mid:shiva",
     "capPos": "bottom"
    },
    {
     "text": "",
     "dur": 1.0,
     "cam": "ecu:mena",
     "sfx": "crack",
     "shake": 6,
     "bang": "THUD!|धम्म!",
     "bangPos": "980,170"
    },
    {
     "who": "narrator",
     "text": "Mena fell to the ground in a faint, like a creeper struck by the wind.",
     "text_hi": "मेना हवा से गिरी लता की तरह बेहोश होकर धरती पर गिर पड़ीं।",
     "cam": "wide",
     "capPos": "bottom"
    }
   ],
