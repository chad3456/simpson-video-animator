   "lines": [
    {
     "text": "",
     "dur": 0.6,
     "cam": "wide"
    },
    {
     "who": "rati",
     "text": "Lord, today everyone is happy except me. My husband burned so that this wedding could happen. Give him back to me.",
     "text_hi": "प्रभु, आज मेरे सिवा सब प्रसन्न हैं। मेरे पति इसी विवाह के लिए जले थे। उन्हें मुझे लौटा दीजिए।",
     "cam": "mid:rati"
    },
    {
     "who": "shiva",
     "text": "So be it, Rati.",
     "text_hi": "ऐसा ही हो, रति।",
     "cam": "mid:shiva"
    },
    {
     "text": "",
     "dur": 2.0,
     "cam": "wide",
     "sfx": "swell",
     "sparkle": true,
     "flash": true
    },
    {
     "who": "narrator",
     "text": "With a single glance, Kama rose from his own ashes, as handsome as before.",
     "text_hi": "एक दृष्टि से कामदेव अपनी ही भस्म से उठ खड़े हुए, पहले जैसे सुंदर।",
     "cam": "wide",
     "capPos": "bottom"
    },
    {
     "who": "kama",
     "text": "Lord, I bow to you. I shot at you, and you have given me back my life.",
     "text_hi": "प्रभु, आपको प्रणाम। मैंने आप पर बाण चलाया, और आपने मुझे जीवन लौटा दिया।",
     "cam": "mid:kama"
    }
   ],
