   "lines": [
    {
     "text": "",
     "dur": 0.4,
     "cam": "wide",
     "sfx": "nagara"
    },
    {
     "who": "mena",
     "text": "नारद, मुझे पहले उन्हें देखना है। वे कैसे पुरुष हैं, जिनके लिए मेरी बेटी ने ऐसा तप किया?",
     "text_hi": "नारद, मुझे पहले उन्हें देखना है। वे कैसे पुरुष हैं, जिनके लिए मेरी बेटी ने ऐसा तप किया?",
     "cam": "mid:mena"
    },
    {
     "who": "narrator",
     "text": "सबसे पहले गंधर्व आए, गाते हुए, चमकते वस्त्रों में, और तेजस्वी वसु।",
     "text_hi": "सबसे पहले गंधर्व आए, गाते हुए, चमकते वस्त्रों में, और तेजस्वी वसु।",
     "camMove": true,
     "cam": "wide"
    },
    {
     "who": "mena",
     "text": "क्या यही हैं? यही शिव होंगे!",
     "text_hi": "क्या यही हैं? यही शिव होंगे!",
     "cam": "two:mena,deva"
    },
    {
     "who": "narad",
     "text": "नहीं। वे तो बस उनके सेवक हैं।",
     "text_hi": "नहीं। वे तो बस उनके सेवक हैं।",
     "cam": "mid:narad"
    },
    {
     "who": "narrator",
     "text": "फिर आए अग्नि, दुगने तेजस्वी। फिर यम, फिर वरुण, फिर वायु, फिर कुबेर, हर एक पिछले से अधिक तेजस्वी।",
     "text_hi": "फिर आए अग्नि, दुगने तेजस्वी। फिर यम, फिर वरुण, फिर वायु, फिर कुबेर, हर एक पिछले से अधिक तेजस्वी।",
     "camMove": true,
     "cam": "wide",
     "capPos": "bottom"
    },
    {
     "who": "mena",
     "text": "वह! निश्चय ही वही रुद्र हैं!",
     "text_hi": "वह! निश्चय ही वही रुद्र हैं!",
     "cam": "mid:mena"
    },
    {
     "who": "narad",
     "text": "नहीं।",
     "text_hi": "नहीं।",
     "cam": "mid:narad"
    },
    {
     "who": "narrator",
     "text": "देवराज इंद्र। फिर चंद्रमा। फिर सूर्य। फिर स्वयं ब्रह्मा, ऋषियों से वंदित।",
     "text_hi": "देवराज इंद्र। फिर चंद्रमा। फिर सूर्य। फिर स्वयं ब्रह्मा, ऋषियों से वंदित।",
     "camMove": true,
     "cam": "wide",
     "capPos": "bottom"
    },
    {
     "who": "narad",
     "text": "नहीं, नहीं, और नहीं।",
     "text_hi": "नहीं, नहीं, और नहीं।",
     "cam": "mid:narad"
    },
    {
     "who": "narrator",
     "text": "और फिर आए विष्णु, वर्षा के बादल जैसे साँवले, पीतांबर में, शंख और चक्र लिए, करोड़ों कामदेवों से भी सुंदर।",
     "text_hi": "और फिर आए विष्णु, वर्षा के बादल जैसे साँवले, पीतांबर में, शंख और चक्र लिए, करोड़ों कामदेवों से भी सुंदर।",
     "camMove": true,
     "cam": "wide",
     "sfx": "sparkle"
    },
    {
     "who": "mena",
     "text": "यही शिव हैं! इसमें कोई संदेह नहीं!",
     "text_hi": "यही शिव हैं! इसमें कोई संदेह नहीं!",
     "cam": "close:mena"
    },
    {
     "who": "narad",
     "text": "यह विष्णु हैं, जो शिव को प्रिय हैं। शिव इनसे भी बड़े हैं। मैं उनका वर्णन भी नहीं कर सकता।",
     "text_hi": "यह विष्णु हैं, जो शिव को प्रिय हैं। शिव इनसे भी बड़े हैं। मैं उनका वर्णन भी नहीं कर सकता।",
     "cam": "mid:narad"
    },
    {
     "who": "mena",
     "text": "यदि ये सब उनके सेवक हैं, तो मेरी बेटी कितनी भाग्यशाली है!",
     "text_hi": "यदि ये सब उनके सेवक हैं, तो मेरी बेटी कितनी भाग्यशाली है!",
     "cam": "mid:mena"
    }
   ],
