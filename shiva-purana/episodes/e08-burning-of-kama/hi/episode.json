    {
     "who": "narrator",
     "text": "मेना और हिमवान के घर एक पुत्री जन्मी, नीलकमल की तरह साँवली और दमकती। उन्होंने उसका नाम पार्वती रखा, पर्वत की पुत्री। कुछ उसे काली कहते, कुछ उमा।",
     "text_hi": "मेना और हिमवान के घर एक पुत्री जन्मी, नीलकमल की तरह साँवली और दमकती। उन्होंने उसका नाम पार्वती रखा, पर्वत की पुत्री। कुछ उसे काली कहते, कुछ उमा।",
     "cam": "wide"
    },
    {
     "who": "narrator",
     "text": "जब वह बालिका थी, नारद मिलने आए, और हिमवान ने उनसे उसका हाथ देखने को कहा।",
     "text_hi": "जब वह बालिका थी, नारद मिलने आए, और हिमवान ने उनसे उसका हाथ देखने को कहा।",
     "camMove": true,
     "cam": "wide",
     "sfx": "veena"
    },
    {
     "who": "narad",
     "text": "इसका पति एक योगी होगा। उसके न माता होंगे, न पिता। वह सुंदर वस्त्र नहीं पहनेगा, और बिना घर के रहेगा।",
     "text_hi": "इसका पति एक योगी होगा। उसके न माता होंगे, न पिता। वह सुंदर वस्त्र नहीं पहनेगा, और बिना घर के रहेगा।",
     "cam": "mid:narad"
    },
    {
     "who": "mena",
     "text": "यह मेरी पुत्री के लिए कैसा पति हुआ?",
     "text_hi": "यह मेरी पुत्री के लिए कैसा पति हुआ?",
