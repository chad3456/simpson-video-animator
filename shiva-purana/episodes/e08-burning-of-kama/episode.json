   "lines": [
    {
     "text": "",
     "dur": 0.6,
     "cam": "wide",
     "sfx": "sparkle",
     "conch": true
    },
    {
     "who": "narrator",
     "text": "A daughter was born to Mena and Himavan, dark and glowing like a blue lotus. They named her Parvati, daughter of the mountain. Some called her Kali, some Uma.",
     "text_hi": "मेना और हिमवान के घर एक पुत्री जन्मी, नीलकमल की तरह साँवली और दमकती। उन्होंने उसका नाम पार्वती रखा, पर्वत की पुत्री। कुछ उसे काली कहते, कुछ उमा।",
     "cam": "wide"
    },
    {
     "who": "narrator",
     "text": "When she was a girl, Narada came to visit, and Himavan asked him to read her palm.",
     "text_hi": "जब वह बालिका थी, नारद मिलने आए, और हिमवान ने उनसे उसका हाथ देखने को कहा।",
     "camMove": true,
     "cam": "wide",
     "sfx": "veena"
    },
    {
     "who": "narad",
     "text": "Her husband will be a yogi. He will have no mother and no father. He wears no fine clothes, and lives without any home.",
     "text_hi": "इसका पति एक योगी होगा। उसके न माता होंगे, न पिता। वह सुंदर वस्त्र नहीं पहनेगा, और बिना घर के रहेगा।",
     "cam": "mid:narad"
    },
    {
     "who": "mena",
     "text": "What sort of husband is that for my daughter?",
     "text_hi": "यह मेरी पुत्री के लिए कैसा पति हुआ?",
     "cam": "mid:mena"
    },
    {
     "who": "narad",
     "text": "Do not grieve. Every sign I named belongs to Shiva. She will be his wife, as she was before.",
     "text_hi": "दुखी मत होइए। मैंने जो भी लक्षण बताए, वे सब शिव के हैं। यह उनकी पत्नी बनेगी, जैसे पहले थी।",
     "cam": "close:narad"
    },
    {
     "who": "narrator",
     "text": "And from that day, Parvati's heart belonged to Shiva.",
     "text_hi": "और उस दिन से पार्वती का हृदय शिव का हो गया।",
     "cam": "close:parvati",
     "capPos": "bottom"
    }
   ],
