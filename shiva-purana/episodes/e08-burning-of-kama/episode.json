   "lines": [
    {
     "text": "",
     "dur": 0.6,
     "cam": "wide",
     "sfx": "sparkle"
    },
    {
     "who": "narrator",
     "text": "Suddenly, out of season, spring came to the frozen mountain. Trees burst into flower. Bees hummed. Cool fragrant winds began to blow.",
     "text_hi": "अचानक, बेमौसम, जमे हुए पर्वत पर वसंत आ गया। पेड़ फूलों से लद गए। भौंरे गुनगुनाने लगे। ठंडी सुगंधित हवा चलने लगी।",
     "camMove": true,
     "cam": "wide"
    },
    {
     "who": "narrator",
     "text": "Kama hid among the trees and drew his bow of sugarcane, strung with bees.",
     "text_hi": "कामदेव पेड़ों के बीच छिप गए और भौंरों की डोरी वाला अपना गन्ने का धनुष ताना।",
     "cam": "mid:kama",
     "capPos": "bottom"
    },
    {
     "text": "",
     "dur": 1.0,
     "cam": "wide",
     "sfx": "whoosh",
     "bang": "THWIPP!|सर्र!",
     "bangPos": "520,170"
    },
    {
     "who": "narrator",
     "text": "For a moment, just a moment, Shiva's mind stirred. He opened his eyes and saw Parvati.",
     "text_hi": "एक पल के लिए, बस एक पल, शिव का मन डोला। उन्होंने आँखें खोलीं और पार्वती को देखा।",
     "cam": "mid:shiva"
    },
    {
     "who": "shiva",
     "text": "I was deep in meditation. Who has done this? Who has disturbed my mind?",
     "text_hi": "मैं गहरे ध्यान में था। यह किसने किया? किसने मेरा मन विचलित किया?",
     "cam": "close:shiva"
    },
    {
     "who": "narrator",
     "text": "He looked around, and saw Kama on his left, bow drawn, about to shoot again.",
     "text_hi": "उन्होंने चारों ओर देखा, और बाईं ओर कामदेव को धनुष ताने, फिर से बाण चलाने को तैयार पाया।",
     "cam": "two:shiva,kama",
     "capPos": "bottom"
    }
   ],
