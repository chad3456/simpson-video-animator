    {
     "who": "parvati",
     "text": "My beauty did not win him. My service did not win him. Then I will win him the way he knows best.",
     "text_hi": "मेरी सुंदरता उन्हें नहीं जीत पाई। मेरी सेवा उन्हें नहीं जीत पाई। तो मैं उन्हें उसी तरह जीतूँगी जो वे सबसे अच्छी तरह जानते हैं।",
     "cam": "mid:parvati"
    },
    {
     "who": "parvati",
     "text": "With tapas.",
     "text_hi": "तपस्या से।",
     "cam": "close:parvati"
    }
