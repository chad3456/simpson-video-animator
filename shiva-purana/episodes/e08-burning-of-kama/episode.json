     "cam": "wide",
     "sfx": "om"
    },
    {
     "who": "narrator",
     "text": "Shiva had come to the Himalaya to meditate. With her father's leave, Parvati served him every day. She brought flowers, water and fruit.",
     "text_hi": "शिव ध्यान करने हिमालय आए थे। पिता की अनुमति से पार्वती रोज़ उनकी सेवा करने लगीं। वे फूल, जल और फल लातीं।",
     "cam": "wide"
    },
    {
     "who": "narrator",
     "text": "Shiva never opened his eyes.",
     "text_hi": "शिव ने कभी आँखें नहीं खोलीं।",
     "cam": "mid:shiva",
     "capPos": "bottom"
