    {
     "who": "narrator",
     "text": "शिव ने उनकी परीक्षा लेने सात महर्षियों को भेजा।",
     "text_hi": "शिव ने उनकी परीक्षा लेने सात महर्षियों को भेजा।",
     "cam": "wide"
    },
    {
     "who": "vasishtha",
     "text": "बेटी, शिव के लिए स्वयं को क्यों सताती हो? वह भटकता भिखारी है। उसने बिना कारण कामदेव को जला दिया। उसने सती को मरने दिया।",
     "text_hi": "बेटी, शिव के लिए स्वयं को क्यों सताती हो? वह भटकता भिखारी है। उसने बिना कारण कामदेव को जला दिया। उसने सती को मरने दिया।",
     "cam": "mid:vasishtha"
    },
    {
     "who": "vasishtha",
     "text": "उसकी जगह विष्णु से विवाह कर लो। वे सुंदर हैं, दयालु हैं, वैकुंठ में रहते हैं।",
     "text_hi": "उसकी जगह विष्णु से विवाह कर लो। वे सुंदर हैं, दयालु हैं, वैकुंठ में रहते हैं।",
     "cam": "close:vasishtha"
    },
    {
     "who": "parvati",
     "text": "ऋषियो, आप जो मानते हैं, वह कहते हैं। पर मैं शिव से विवाह करूँगी, या किसी से नहीं। यदि वे मुझे अस्वीकार भी करें, तो मैं हज़ार जन्मों तक तप करूँगी।",
     "text_hi": "ऋषियो, आप जो मानते हैं, वह कहते हैं। पर मैं शिव से विवाह करूँगी, या किसी से नहीं। यदि वे मुझे अस्वीकार भी करें, तो मैं हज़ार जन्मों तक तप करूँगी।",
     "cam": "mid:parvati"
