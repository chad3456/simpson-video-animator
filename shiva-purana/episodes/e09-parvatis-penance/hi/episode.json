   "lines": [
    {
     "text": "",
     "dur": 0.4,
     "cam": "wide"
    },
    {
     "who": "narrator",
     "text": "फिर एक दिन एक युवा ब्रह्मचारी आया, जटाधारी, हाथ में दंड, अपने तप से दमकता हुआ।",
     "text_hi": "फिर एक दिन एक युवा ब्रह्मचारी आया, जटाधारी, हाथ में दंड, अपने तप से दमकता हुआ।",
     "camMove": true,
     "cam": "wide"
    },
    {
     "who": "jatila",
     "text": "इतनी कठोर तपस्या, इतनी कम उम्र में! क्या चाहती हो, देवी? स्वर्ग? धन? पति?",
     "text_hi": "इतनी कठोर तपस्या, इतनी कम उम्र में! क्या चाहती हो, देवी? स्वर्ग? धन? पति?",
     "cam": "mid:jatila"
    },
    {
     "who": "vijaya",
     "text": "वे शिव को पति के रूप में चाहती हैं।",
     "text_hi": "वे शिव को पति के रूप में चाहती हैं।",
     "cam": "mid:vijaya"
    },
    {
     "who": "jatila",
     "text": "शिव? हा! उसका न कुल है, न घर, न वस्त्र। वह बैल पर चढ़ता है और श्मशान की भस्म मलता है।",
     "text_hi": "शिव? हा! उसका न कुल है, न घर, न वस्त्र। वह बैल पर चढ़ता है और श्मशान की भस्म मलता है।",
     "cam": "mid:jatila"
    },
    {
     "who": "jatila",
     "text": "गले में साँप। मित्र प्रेत। सोचो विवाह कैसा होगा! तुम रेशम में, और वह बाघ की खाल में।",
     "text_hi": "गले में साँप। मित्र प्रेत। सोचो विवाह कैसा होगा! तुम रेशम में, और वह बाघ की खाल में।",
     "cam": "close:jatila"
    },
    {
     "who": "parvati",
     "text": "बस! तुम शिव के बारे में कुछ नहीं जानते। वे गुणों से परे हैं। जिस भस्म का तुम उपहास करते हो, उसे स्वयं देवता धारण करते हैं!",
     "text_hi": "बस! तुम शिव के बारे में कुछ नहीं जानते। वे गुणों से परे हैं। जिस भस्म का तुम उपहास करते हो, उसे स्वयं देवता धारण करते हैं!",
     "cam": "mid:parvati"
    },
    {
     "who": "parvati",
     "text": "जो शिव की निंदा सुनता है, वह भी पाप का भागी होता है। विजया, चलो। मैं यहाँ एक पल भी नहीं रुकूँगी।",
     "text_hi": "जो शिव की निंदा सुनता है, वह भी पाप का भागी होता है। विजया, चलो। मैं यहाँ एक पल भी नहीं रुकूँगी।",
     "cam": "close:parvati"
    },
    {
