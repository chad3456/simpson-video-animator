     "tint": "#ff6a0a,0.12"
    },
    {
     "who": "narrator",
     "text": "गर्मी में वे जलती धूप में धधकती अग्नियों के बीच बैठीं।",
     "text_hi": "गर्मी में वे जलती धूप में धधकती अग्नियों के बीच बैठीं।",
     "cam": "wide",
     "capPos": "bottom"
    },
    {
     "text": "",
     "dur": 1.0,
     "cam": "wide",
     "sfx": "wind",
     "tint": "#a8c8f0,0.15"
    },
    {
     "who": "narrator",
     "text": "सर्दी में वे रात भर बर्फ़ीले पानी में खड़ी रहीं।",
     "text_hi": "सर्दी में वे रात भर बर्फ़ीले पानी में खड़ी रहीं।",
     "cam": "wide",
     "capPos": "bottom"
    },
    {
     "who": "narrator",
     "text": "पहले उन्होंने फल खाए। फिर केवल पत्ते। फिर पत्ते भी छोड़ दिए। तब संसार ने उन्हें अपर्णा कहा, जिसने पत्ता भी नहीं खाया।",
     "text_hi": "पहले उन्होंने फल खाए। फिर केवल पत्ते। फिर पत्ते भी छोड़ दिए। तब संसार ने उन्हें अपर्णा कहा, जिसने पत्ता भी नहीं खाया।",
