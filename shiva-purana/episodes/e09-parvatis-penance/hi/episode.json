     "sfx": "om",
     "swell": true,
     "flash": true,
     "bang": "OM|ॐ",
     "bangPos": "640,150",
     "bangCol": "#ffd22e"
    },
    {
     "who": "shiva",
     "text": "मुझे छोड़कर कहाँ जाओगी, पार्वती?",
     "text_hi": "मुझे छोड़कर कहाँ जाओगी, पार्वती?",
     "cam": "mid:shiva"
    },
    {
     "who": "narrator",
     "text": "युवा तपस्वी कहीं नहीं था। उसकी जगह स्वयं शिव खड़े थे, मुस्कुराते हुए।",
     "text_hi": "युवा तपस्वी कहीं नहीं था। उसकी जगह स्वयं शिव खड़े थे, मुस्कुराते हुए।",
     "cam": "two:shiva,parvati",
     "capPos": "bottom"
    },
    {
     "who": "shiva",
     "text": "मैंने तुम्हारी परीक्षा ली, और तुम नहीं डिगीं। तुम्हारे तप ने मुझे मोल ले लिया है। मैं तुम्हारा हूँ। जो चाहो माँगो।",
     "text_hi": "मैंने तुम्हारी परीक्षा ली, और तुम नहीं डिगीं। तुम्हारे तप ने मुझे मोल ले लिया है। मैं तुम्हारा हूँ। जो चाहो माँगो।",
     "cam": "close:shiva"
    },
    {
     "who": "parvati",
     "text": "तो मेरे पिता से मेरा हाथ माँगिए, प्रभु। संसार देखे कि आप विधिपूर्वक मुझसे विवाह करते हैं।",
     "text_hi": "तो मेरे पिता से मेरा हाथ माँगिए, प्रभु। संसार देखे कि आप विधिपूर्वक मुझसे विवाह करते हैं।",
     "cam": "mid:parvati"
    },
    {
     "who": "shiva",
     "text": "ऐसा ही हो।",
     "text_hi": "ऐसा ही हो।",
     "cam": "two:shiva,parvati"
    },
