   "lines": [
    {
     "text": "",
     "dur": 0.5,
     "cam": "wide"
    },
    {
     "who": "parvati",
     "text": "Mother, Father has agreed. Tomorrow morning I will go to the forest and do tapas, until I win Shiva.",
     "text_hi": "माँ, पिताजी मान गए हैं। कल सुबह मैं वन जाऊँगी और तप करूँगी, जब तक शिव को पा न लूँ।",
     "cam": "mid:parvati"
    },
    {
     "who": "mena",
     "text": "Your body is so delicate, child. Do your tapas here at home. All the gods are here, all the holy places. U... ma! Oh, do not go!",
     "text_hi": "तेरा शरीर इतना कोमल है, बेटी। यहीं घर पर तप कर ले। सब देवता यहीं हैं, सब तीर्थ यहीं हैं। उ... मा! अरी, मत जा!",
     "cam": "mid:mena"
    },
    {
     "who": "narrator",
     "text": "\"U ma.\" Oh, do not. And that is how she came to be called Uma.",
     "text_hi": "\"उ मा।\" अरी, मत जा। और इसी से उनका नाम पड़ा उमा।",
     "camMove": true,
     "cam": "two:parvati,mena",
     "capPos": "bottom"
    },
    {
     "who": "narrator",
     "text": "But Mena saw how her daughter suffered, and at last she let her go.",
     "text_hi": "पर मेना ने देखा कि बेटी कितनी दुखी है, और अंततः उन्होंने उसे जाने दिया।",
     "cam": "wide"
    }
   ],
