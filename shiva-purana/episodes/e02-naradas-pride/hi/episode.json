    {
     "text": "",
     "dur": 1.2,
     "cam": "wide",
     "sfx": "boom",
     "flash": true
    },
    {
     "who": "vishnu",
     "text": "मैं आपका शाप स्वीकार करता हूँ, ऋषि। यह शिव की इच्छा से आया है।",
     "text_hi": "मैं आपका शाप स्वीकार करता हूँ, ऋषि। यह शिव की इच्छा से आया है।",
     "cam": "mid:vishnu"
    },
    {
     "who": "narrator",
     "text": "और उसी क्षण शिव ने माया हटा ली। नारद का मन ऐसे साफ़ हो गया, जैसे वर्षा के बाद आकाश।",
     "text_hi": "और उसी क्षण शिव ने माया हटा ली। नारद का मन ऐसे साफ़ हो गया, जैसे वर्षा के बाद आकाश।",
     "cam": "wide",
     "capPos": "bottom",
     "sfx": "sparkle"
    },
    {
     "who": "narad",
     "text": "प्रभु, यह मैंने क्या कर दिया? मैंने दुर्वचन कहे। मैंने आपको शाप दे दिया! यह शाप झूठा हो जाए!",
     "text_hi": "प्रभु, यह मैंने क्या कर दिया? मैंने दुर्वचन कहे। मैंने आपको शाप दे दिया! यह शाप झूठा हो जाए!",
     "cam": "close:narad"
    },
    {
     "who": "vishnu",
     "text": "दुखी मत हो। यह शिव की लीला थी, तुम्हारा अभिमान तोड़ने के लिए। शाप सत्य होगा, और वह संसार के कल्याण के लिए होगा।",
     "text_hi": "दुखी मत हो। यह शिव की लीला थी, तुम्हारा अभिमान तोड़ने के लिए। शाप सत्य होगा, और वह संसार के कल्याण के लिए होगा।",
     "cam": "mid:vishnu"
    },
    {
     "who": "vishnu",
     "text": "काशी जाओ। शिव के नाम गाओ, तुम्हारा मन शांत हो जाएगा।",
     "text_hi": "काशी जाओ। शिव के नाम गाओ, तुम्हारा मन शांत हो जाएगा।",
     "cam": "close:vishnu"
    },
    {
     "who": "narrator",
     "text": "युगों बाद विष्णु ने राम के रूप में जन्म लिया। सीता उनसे बिछड़ीं, और वानरों की सेना ने उन्हें वापस पाने में सहायता की।",
