    {
     "who": "narrator",
     "text": "पर्वत पर वसंत छा गया। फूल खिल उठे, कोयलें गाने लगीं, और कामदेव ने अपना पुष्प-धनुष ताना।",
     "text_hi": "पर्वत पर वसंत छा गया। फूल खिल उठे, कोयलें गाने लगीं, और कामदेव ने अपना पुष्प-धनुष ताना।",
     "cam": "wide"
    },
    {
     "text": "",
     "dur": 1.2,
     "cam": "wide",
     "sfx": "whoosh",
     "bang": "TWANG!|टंकार!",
     "bangPos": "420,180"
    },
    {
     "who": "narrator",
     "text": "कुछ नहीं हुआ। नारद ने आँखें तक नहीं खोलीं।",
     "text_hi": "कुछ नहीं हुआ। नारद ने आँखें तक नहीं खोलीं।",
     "cam": "mid:narad",
     "capPos": "bottom"
    },
    {
     "who": "kama",
     "text": "मेरे बाण... यहाँ उनमें कोई शक्ति नहीं!",
     "text_hi": "मेरे बाण... यहाँ उनमें कोई शक्ति नहीं!",
     "cam": "mid:kama"
    },
    {
     "who": "narrator",
     "text": "क्योंकि यह वही स्थान था जहाँ शिव ने कभी कामदेव को भस्म किया था, और शिव ने कहा था कि यहाँ काम की कोई चाल कभी नहीं चलेगी।",
     "text_hi": "क्योंकि यह वही स्थान था जहाँ शिव ने कभी कामदेव को भस्म किया था, और शिव ने कहा था कि यहाँ काम की कोई चाल कभी नहीं चलेगी।",
     "cam": "wide",
     "capPos": "bottom"
    },
    {
     "who": "narrator",
     "text": "नारद यह सब नहीं जानते थे। जब उन्होंने आँखें खोलीं, तो उन्हें लगा कि उन्होंने अपने बल पर काम को जीत लिया है।",
     "text_hi": "नारद यह सब नहीं जानते थे। जब उन्होंने आँखें खोलीं, तो उन्हें लगा कि उन्होंने अपने बल पर काम को जीत लिया है।",
     "camMove": true,
     "cam": "full:narad"
    },
    {
     "who": "narad",
     "text": "मैंने स्वयं कामदेव को जीत लिया!",
     "text_hi": "मैंने स्वयं कामदेव को जीत लिया!",
