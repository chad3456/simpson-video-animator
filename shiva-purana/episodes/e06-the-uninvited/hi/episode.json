    {
     "who": "narrator",
     "text": "दक्ष ने कनखल में संसार का सबसे बड़ा यज्ञ आरंभ किया। भृगु मुख्य पुरोहित थे। विष्णु आए, ब्रह्मा आए, इंद्र और सभी देवता आए।",
     "text_hi": "दक्ष ने कनखल में संसार का सबसे बड़ा यज्ञ आरंभ किया। भृगु मुख्य पुरोहित थे। विष्णु आए, ब्रह्मा आए, इंद्र और सभी देवता आए।",
     "cam": "wide"
    },
    {
     "who": "narrator",
     "text": "सबको बुलाया गया। सिवाय शिव के। और सिवाय सती के।",
     "text_hi": "सबको बुलाया गया। सिवाय शिव के। और सिवाय सती के।",
     "cam": "mid:daksha",
     "capPos": "bottom"
    },
    {
     "who": "dadhichi",
     "text": "दक्ष! शिव कहाँ हैं? उनके बिना यह यज्ञ एक शव है। इसका अंत विनाश में होगा!",
     "text_hi": "दक्ष! शिव कहाँ हैं? उनके बिना यह यज्ञ एक शव है। इसका अंत विनाश में होगा!",
     "cam": "mid:dadhichi"
    },
    {
     "who": "daksha",
     "text": "मेरे पास यज्ञ के स्वामी विष्णु हैं। मुझे उस भटकने वाले की क्या ज़रूरत?",
     "text_hi": "मेरे पास यज्ञ के स्वामी विष्णु हैं। मुझे उस भटकने वाले की क्या ज़रूरत?",
     "cam": "mid:daksha"
    },
    {
     "who": "dadhichi",
     "text": "तो मैं इसे जलते देखने के लिए नहीं रुकूँगा।",
     "text_hi": "तो मैं इसे जलते देखने के लिए नहीं रुकूँगा।",
     "cam": "close:dadhichi"
    },
    {
     "who": "narrator",
     "text": "वृद्ध ऋषि चले गए। कुछ और भी उनके पीछे चले गए। दक्ष हँस पड़े।",
