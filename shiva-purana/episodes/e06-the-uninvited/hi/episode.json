    {
     "who": "narrator",
     "text": "जब दक्ष महासभा में आए, हर ऋषि और देवता उनके सम्मान में खड़ा हो गया। हर एक, सिवाय उनके पिता ब्रह्मा और शिव के।",
     "text_hi": "जब दक्ष महासभा में आए, हर ऋषि और देवता उनके सम्मान में खड़ा हो गया। हर एक, सिवाय उनके पिता ब्रह्मा और शिव के।",
     "camMove": true,
     "cam": "wide"
    },
    {
     "who": "daksha",
     "text": "देखो इसे! मेरा दामाद, जिसे मेरे पुत्र जैसा होना चाहिए, मेरे लिए उठा तक नहीं!",
     "text_hi": "देखो इसे! मेरा दामाद, जिसे मेरे पुत्र जैसा होना चाहिए, मेरे लिए उठा तक नहीं!",
     "cam": "mid:daksha"
    },
    {
     "who": "daksha",
     "text": "यह श्मशानों में प्रेतों के साथ घूमता है, भस्म लगाता है, और इसमें कोई शिष्टाचार नहीं। इसे किसी यज्ञ में भाग नहीं मिलेगा!",
     "text_hi": "यह श्मशानों में प्रेतों के साथ घूमता है, भस्म लगाता है, और इसमें कोई शिष्टाचार नहीं। इसे किसी यज्ञ में भाग नहीं मिलेगा!",
     "cam": "close:daksha"
    },
    {
     "who": "narrator",
     "text": "शिव ने कुछ नहीं कहा। वे पर्वत की तरह स्थिर बैठे रहे।",
     "text_hi": "शिव ने कुछ नहीं कहा। वे पर्वत की तरह स्थिर बैठे रहे।",
     "cam": "mid:shiva",
     "capPos": "bottom"
    },
    {
     "who": "nandi",
     "text": "तुम मेरे स्वामी को शाप देते हो? तो मेरी भी सुनो! तुम और तुम्हारे अनुयायी सच्चा ज्ञान खो देंगे। और तुम, दक्ष, बकरे का मुँह पाओगे!",
     "text_hi": "तुम मेरे स्वामी को शाप देते हो? तो मेरी भी सुनो! तुम और तुम्हारे अनुयायी सच्चा ज्ञान खो देंगे। और तुम, दक्ष, बकरे का मुँह पाओगे!",
     "cam": "mid:nandi"
    },
    {
     "who": "shiva",
     "text": "नंदी। बस। क्रोध ज्ञान नहीं है। चलो।",
     "text_hi": "नंदी। बस। क्रोध ज्ञान नहीं है। चलो।",
     "cam": "mid:shiva"
    }
