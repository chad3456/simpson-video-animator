   "lines": [
    {
     "text": "",
     "dur": 0.6,
     "cam": "wide",
     "sfx": "conch",
     "bells": true
    },
    {
     "who": "narrator",
     "text": "Daksha began the greatest sacrifice the world had ever seen, at Kanakhala. Bhrigu led the priests. Vishnu came, Brahma came, Indra and all the gods came.",
     "text_hi": "दक्ष ने कनखल में संसार का सबसे बड़ा यज्ञ आरंभ किया। भृगु मुख्य पुरोहित थे। विष्णु आए, ब्रह्मा आए, इंद्र और सभी देवता आए।",
     "cam": "wide"
    },
    {
     "who": "narrator",
     "text": "Everyone was invited. Except Shiva. And except Sati.",
     "text_hi": "सबको बुलाया गया। सिवाय शिव के। और सिवाय सती के।",
     "cam": "mid:daksha",
     "capPos": "bottom"
    },
    {
     "who": "dadhichi",
     "text": "Daksha! Where is Shiva? Without him, this sacrifice is a corpse. It will end in ruin!",
     "text_hi": "दक्ष! शिव कहाँ हैं? उनके बिना यह यज्ञ एक शव है। इसका अंत विनाश में होगा!",
     "cam": "mid:dadhichi"
    },
    {
     "who": "daksha",
     "text": "I have Vishnu, the lord of sacrifice. What do I need with that wanderer?",
     "text_hi": "मेरे पास यज्ञ के स्वामी विष्णु हैं। मुझे उस भटकने वाले की क्या ज़रूरत?",
     "cam": "mid:daksha"
    },
    {
     "who": "dadhichi",
     "text": "Then I will not stay to watch it burn.",
     "text_hi": "तो मैं इसे जलते देखने के लिए नहीं रुकूँगा।",
     "cam": "close:dadhichi"
    },
    {
     "who": "narrator",
     "text": "The old sage walked out. A few others followed him. Daksha laughed.",
     "text_hi": "वृद्ध ऋषि चले गए। कुछ और भी उनके पीछे चले गए। दक्ष हँस पड़े।",
     "camMove": true,
     "cam": "wide",
     "capPos": "bottom"
    }
   ],
