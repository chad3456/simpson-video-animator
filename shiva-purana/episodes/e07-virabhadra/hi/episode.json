     "thunder": true,
     "flash": true,
     "shake": 14,
     "bang": "KRA-THOOM!|धड़ाम!",
     "bangPos": "640,170"
    },
    {
     "who": "narrator",
     "text": "लट दो भागों में बँट गई। एक भाग से वीरभद्र उठे, आकाश जितने ऊँचे, प्रलय की अग्नि के समान धधकते हुए। दूसरे से महाकाली प्रकट हुईं, भूत-प्रेतों की सेना से घिरी।",
     "text_hi": "लट दो भागों में बँट गई। एक भाग से वीरभद्र उठे, आकाश जितने ऊँचे, प्रलय की अग्नि के समान धधकते हुए। दूसरे से महाकाली प्रकट हुईं, भूत-प्रेतों की सेना से घिरी।",
     "cam": "wide",
     "tint": "#5a0a0a,0.2"
    },
    {
     "who": "virabhadra",
     "text": "प्रभु, आज्ञा दीजिए! क्या मैं समुद्र सुखा दूँ? पर्वत चूर कर दूँ? देवताओं को भस्म कर दूँ?",
     "text_hi": "प्रभु, आज्ञा दीजिए! क्या मैं समुद्र सुखा दूँ? पर्वत चूर कर दूँ? देवताओं को भस्म कर दूँ?",
     "cam": "low:virabhadra"
    },
