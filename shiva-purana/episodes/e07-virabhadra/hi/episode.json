    },
    {
     "who": "narrator",
     "text": "शिव की आँखें लाल हो गईं। उन्होंने अपनी जटा से एक लट उखाड़ी, और उसे पर्वत पर दे पटका।",
     "text_hi": "शिव की आँखें लाल हो गईं। उन्होंने अपनी जटा से एक लट उखाड़ी, और उसे पर्वत पर दे पटका।",
     "cam": "close:shiva"
    },
    {
     "text": "",
     "dur": 1.2,
     "cam": "wide",
     "sfx": "whoosh"
    },
    {
     "text": "",
     "dur": 1.6,
     "cam": "wide",
