     "y": 660,
     "text": "more than double",
     "color": "#ff5a7a",
     "d": 2.6,
     "in": 2
    }
   ],
   "lines": [
    {
     "text": "Saad also argues that empathy is handed out unevenly. Some groups are always seen as victims, others almost never."
    },
    {
     "text": "After the Hamas attack on Israel on October seventh, 2023, which killed around twelve hundred people, antisemitic incidents surged across the West."
    },
    {
     "text": "In the United States, the Anti-Defamation League recorded nearly nine thousand incidents in 2023, more than double the year before."
    }
   ]
  },
  {
   "type": "scene",
   "id": "autopilot",
   "bg": {
    "kind": "deep",
    "pal": "midnight"
   },
   "els": [
    {
     "id": "ht",
     "type": "particles",
     "x": 640,
     "y": 330,
     "kind": "hearts",
     "n": 10,
     "w": 700,
     "h": 260,
     "anim": "fade"
    },
    {
     "id": "ap",
     "type": "label",
     "x": 640,
     "y": 160,
     "text": "empathy on autopilot?",
     "color": "#ffd166",
     "d": 0.6
    },
    {
     "id": "sh2",
     "type": "icon",
     "x": 640,
     "y": 420,
     "glyph": "globe",
     "r": 70,
     "color": "#5ec8e5",
     "d": 0.4,
