   ],
   "lines": [
    {
     "text": "In 1847, a doctor in Vienna noticed that women in his maternity ward were dying far more often when the doctors came straight from performing autopsies."
    },
    {
     "text": "Ignaz Semmelweis told his colleagues to wash their hands. Deaths plunged. And much of the medical establishment scoffed at him."
    },
    {
     "text": "He died in an asylum. Germ theory later proved him right."
    }
   ]
  },
