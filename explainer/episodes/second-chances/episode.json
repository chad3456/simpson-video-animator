   "lines": [
    {
     "text": "In May 2023, on a New York subway train, a man named Jordan Neely, who was homeless and had a history of mental illness, shouted threats at passengers."
    },
    {
     "text": "A former marine, Daniel Penny, restrained him in a chokehold for several minutes, with help from other riders. Neely died."
    },
    {
     "text": "Penny was charged, and in December 2024 a jury acquitted him."
    }
   ]
