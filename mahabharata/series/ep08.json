   "music": "gita",
   "lines": [
    {
     "who": "NAR",
     "en": "And there, between two armies, time stood still, and Krishna spoke.",
     "hi": "और वहीं, दो सेनाओं के बीच, समय थम गया, और कृष्ण बोले।"
    },
    {
     "who": "KRISHNA",
     "en": "The soul is never born, and it never dies. No weapon can cut it, no fire can burn it. Those you grieve for are eternal.",
     "hi": "आत्मा न कभी जन्म लेती है, न कभी मरती है। इसे कोई शस्त्र काट नहीं सकता, कोई आग जला नहीं सकती। जिनके लिए तुम शोक करते हो, वे शाश्वत हैं।",
     "fx": "divine"
    }
