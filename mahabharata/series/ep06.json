  {
   "id": "e6_yaksha",
   "music": "mystery",
   "lines": [
    {
     "who": "YAKSHA",
     "en": "What is the greatest wonder in the world?",
     "hi": "संसार का सबसे बड़ा आश्चर्य क्या है?",
     "fx": "divine_big"
    },
    {
     "who": "YUDHI",
     "en": "Every day, people die. And yet the living go on as if they will live forever. That is the greatest wonder.",
     "hi": "हर दिन लोग मरते हैं। फिर भी जीवित लोग ऐसे जीते हैं जैसे वे सदा रहेंगे। यही सबसे बड़ा आश्चर्य है।"
    }
   ],
