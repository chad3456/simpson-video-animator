   "id": "e7_choice",
   "music": "krishna",
   "lines": [
    {
     "who": "NAR",
     "en": "Both sides came to Krishna for help. He offered a choice: his whole army, or himself alone, who would carry no weapon.",
     "hi": "दोनों पक्ष सहायता माँगने कृष्ण के पास आए। उन्होंने एक विकल्प दिया: उनकी पूरी सेना, या केवल वे स्वयं, जो कोई शस्त्र नहीं उठाएँगे।",
     "at": 4.6
    },
    {
     "who": "DURYO",
     "en": "I take the army!",
     "hi": "मुझे सेना चाहिए!",
