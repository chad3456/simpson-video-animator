   "lines": [
    {
     "who": "NAR",
     "en": "Shaken, the blind king gave everything back. But Shakuni called one last game, and the Pandavas lost again.",
     "hi": "भयभीत होकर अंधे राजा ने सब लौटा दिया। पर शकुनि ने एक अंतिम खेल बुलाया, और पांडव फिर हार गए।"
    },
    {
     "who": "NAR",
     "en": "The price: twelve years in the forest, and a thirteenth in hiding. If they were found, it would begin again.",
     "hi": "शर्त थी: बारह वर्ष वनवास, और तेरहवाँ वर्ष अज्ञातवास। पकड़े गए, तो फिर से वही सब।"
    }
   ],
