   "id": "e5_bhima",
   "music": "battle",
   "lines": [
    {
     "who": "BHIMA",
     "en": "Hear my vow! I will break Duryodhana's thigh, and on the battlefield I will drink Dushasana's blood!",
     "hi": "मेरी प्रतिज्ञा सुनो! मैं दुर्योधन की जंघा तोड़ूँगा, और रणभूमि में दुःशासन का रक्त पियूँगा!",
     "fx": "roar"
    },
    {
     "who": "DRAUPADI",
     "en": "And I will not tie my hair again until it is washed in that blood.",
     "hi": "और जब तक मेरे केश उस रक्त से धुल न जाएँ, मैं इन्हें फिर नहीं बाँधूँगी।"
    }
